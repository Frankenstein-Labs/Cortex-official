# Site Cortex (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# En local, Vite tourne à part. En production, laisser cette variable vide
# pour utiliser le service Vercel partagé sous /studio.
NEXT_PUBLIC_CORTEX_STUDIO_URL=http://localhost:5173

# Même secret aléatoire long dans le site et dans cortex-platform/.env
CORTEX_SSO_SECRET=replace-with-a-long-random-secret

# Le site appelle encore un service de facturation compatible séparé pour
# checkout, top-up et abonnement; ces endpoints ne sont pas l'API agent /api/v1.
CORTEX_BILLING_API_URL=
X_FRONTEND_KEY=

# Facultatif : analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Facultatif : tests locaux et opérations GitHub
NEXT_PUBLIC_TEST_MODE_ENABLED=false
GITHUB_TOKEN=
